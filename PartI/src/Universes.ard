
-------------------------------------------------
-- Hierarchies of universes, polymorphism
-------------------------------------------------

\func tt : \Type2 => \Type0 -> \Type1

-- `\Type` without a level denotes the infinite universe (it contains every `\Type n`).
-- A definition mentioning only bare `\Type` is NOT level-polymorphic.
\func id (A : \Type) (a : A) => a

-- To be polymorphic in the predicative level, declare named level parameters with `.{...}`
-- and use them as `\Type l`. (The implicit `\lp` of older Arend versions no longer exists.)
\func id'.{l} (A : \Type l) (a : A) => a

\func type.{l} : \Type (\suc l) => \Type l

\func test0.{l} : \Type (\max (\suc (\suc l)) 4) => \Type (\max l 3) -> \Type (\suc l)

\func test1 => id' Nat 0
\func test2 => id' \Type0 Nat
\func test3 => id' (\Type0 -> \Type1) (\lam X => X)
\func test4.{l} => id' (\Pi (A : \Type l) -> A -> A) id'

-- Level arguments are passed with the same `.{...}` syntax. Positional level arguments and
-- the `\levels p h` construct no longer exist; a level argument is a single predicative level.
\func test5.{l} => id'.{\suc l} (\Type l) Nat
\func test6 => id'.{2} \Type1 \Type0

\data Magma.{l} (A : \Type l)
  | con (A -> A -> A)

\data MagmaEx.{l} (A : \Type l) (B : \Type5)
  | conEx (A -> A -> A)

\func test7.{l} : \Type l => MagmaEx.{l} Nat \Type4

\class Magma'.{l} (A : \Type l)
  | \infixl 6 ** : A -> A -> A

\func test8.{l} : \Type (\suc l) => Magma'.{l}

-- Once the universe-typed field A is implemented, the level drops by one:
-- Magma'.{l} Nat lives in \Type l (e.g. Magma'.{5} Nat : \Type5).
\func test9.{l} : \Type l => Magma'.{l} Nat

-- `\Set` cannot be infinite, so it always requires an explicit predicative level.
\class Functor.{l} (F : \Set l -> \Set l)
  | fmap {A B : \Set l} : (A -> B) -> F A -> F B

\data Maybe.{l} (A : \Set l) | nothing | just A

\func test10.{l} : \Type (\suc l) => Functor.{l} Maybe

-------------------------------------------------
-- Induction principles
-------------------------------------------------
\data Empty

\data Unit | unit

\data Bool | false | true

\func T (b : Bool) : \Prop
  | true => Unit
  | false => Empty

\func \infix 4 < (x y : Nat) : Bool
  | 0, 0 => false
  | 0, suc y => true
  | suc x, 0 => false
  | suc x, suc y => x < y

\func Nat-ind (E : Nat -> \Type)
              (r : \Pi (n : Nat) -> (\Pi (k : Nat) -> T (k < n) -> E k) -> E n)
              (n : Nat) : E n => {?} -- prove this as an exercise

-------------------------------------------------
-- Induction-recusrion
-------------------------------------------------

\func isEven (n : Nat) : Bool
  | 0 => true
  | suc n => isOdd n

\func isOdd (n : Nat) : Bool
  | 0 => false
  | suc n => isEven n

\data IsEven (n : Nat) : \Type \with
  | 0 => zero-isEven
  | suc n => suc-isEven (IsOdd n)

\data IsOdd (n : Nat) : \Type \with
  | suc n => suc-isOdd (IsEven n)

-------------------------------------------------
-- Universes via induction-recusrion
-------------------------------------------------

\data Type
  | nat
  | list Type
  | arr Type Type

\data List (A : \Type) | nil | cons A (List A)

\func El (t : Type) : \Set0 \elim t -- \Set0 is almost the same as \Type0, we will discuss the difference later
  | nat => Nat
  | list t => List (El t)
  | arr t1 t2 => El t1 -> El t2

\func idc (t : Type) (x : El t) : El t => x

\data Type' : \Set0
  | nat'
  | list' Type'
  | pi' (a : Type') (El' a -> Type')

\func El' (t : Type') : \Set0 \elim t
  | nat' => Nat
  | list' t => List (El' t)
  | pi' t1 t2 => \Pi (a : El' t1) -> El' (t2 a)

-------------------------------------------------
-- Completeness of specifications
-------------------------------------------------

\func \infixl 6 + (x y : Nat) : Nat \elim y
  | 0 => x
  | suc y => suc (x + y)

\func \infixl 7 * (x y : Nat) : Nat \elim y
  | 0 => 0
  | suc y => x * y + x

-- P1 is correct specification for 'fac', but incomplete.
\func P1 (f : Nat -> Nat) => f 3 = 6
-- P2 is complete, but not correct.
\func P2 (f : Nat -> Nat) => Empty
-- P3 -- correct and complete specification for 'fac'.
\func P3 (f : Nat -> Nat) => \Sigma (f 0 = 1) (\Pi (n : Nat) -> f (suc n) = suc n * f n)

\func isSorted {A : \Type} (x : List A) : \Prop => {?}
\func isPerm {A : \Type} (x y : List A) : \Prop => {?}

\func P {A : \Type} (f : List A -> List A) => \Pi (xs : List A) -> \Sigma (isSorted (f xs)) (isPerm (f xs) xs)
-- where 'isSorted xs' is true iff  'xs' is sorted and
-- 'isPerm xs ys' is true iff 'xs' is a permutation of 'ys'.
